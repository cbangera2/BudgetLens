{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "playwright.config.ts",
    "server/**/*.ts",
    "workers/**/*.ts",
    "src/features/assistant/demo-models.ts",
    "src/features/assistant/relay-policy.ts"
  ]
}
