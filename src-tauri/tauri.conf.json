{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BudgetLens",
  "version": "1.0.0",
  "identifier": "com.cbangera2.budgetlens",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build:desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BudgetLens",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "useHttpsScheme": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": "default-src 'self' ipc: http://ipc.localhost ws://localhost:5173 http://localhost:5173; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: blob: http://localhost:5173; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:5173 http://localhost:5173"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "category": "Finance",
    "icon": [],
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNDOTUxNTNFN0E1QTExNzcKUldSM0VWcDZQaFdWUENMVTRrc1BQQ2lVRi95Uzd4YUFSemZkRVFtVHhrUVdORXlkZzFQa3E4ekQK",
      "endpoints": ["https://github.com/cbangera2/BudgetLens/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
