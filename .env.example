# Local secrets — copy to .env and fill in. Never commit .env.
# The free-models eval loads keys in this order (first hit wins):
#   environment (OPENROUTER_KEY / OPENROUTER_API_KEY),
#   .env, .env.local, .dev.vars (repo root),
#   workers/assistant-relay/.dev.vars (where `wrangler dev` reads it).
#
# IMPORTANT: `wrangler secret put OPENROUTER_KEY` stores the key in Cloudflare
# and `wrangler secret list` will NOT show its value (by design). For local
# evals, paste the SAME key here.

# OpenRouter key (free models still require auth). Get one at
# https://openrouter.ai/keys (a $0-5 capped key is enough for :free models).
OPENROUTER_KEY=sk-or-v1-paste-here

# Optional: override the API base (default https://openrouter.ai/api/v1).
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
